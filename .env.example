# Configure securely in Sites. Never put secrets in browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional Google Maps JavaScript 3D. Off until billing, website/API restrictions
# and Google Console usage quotas are reviewed. Never substitute a server key.
# This browser Maps key is deliberately delivered to visitors after opening 3D.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_3D_ENABLED=false

# Web Push: private P-256 JWK only on the server; public key is safe for subscriptions.
WEB_PUSH_PRIVATE_JWK=
WEB_PUSH_PUBLIC_KEY=
